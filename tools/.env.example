# Copy to .env and fill in. Only the Gemini-backed tools (add-story, gen-world-dna,
# verify-models) need this. import-export and build-site do NOT use Gemini.
GEMINI_API_KEY=your-key-here

# Optional overrides if the default model names are no longer valid.
# GEMINI_TEXT_MODEL=gemini-3.5-flash
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image-preview

# Transcription (optional). The audio pass can use a different (stronger)
# model than the text calls; analysis stays on GEMINI_TEXT_MODEL.
# GEMINI_TRANSCRIBE_MODEL=gemini-3.5-pro
# GEMINI_PRO_MODEL=gemini-3.5-pro

# Bake-off engines (optional — an engine is skipped when its key is missing).
# ELEVENLABS_API_KEY=
# ASSEMBLYAI_API_KEY=
# OPENAI_API_KEY=
# ELEVENLABS_STT_MODEL=scribe_v2
# ASSEMBLYAI_STT_MODEL=universal-3-5-pro
# OPENAI_STT_MODEL=gpt-4o-transcribe-diarize
