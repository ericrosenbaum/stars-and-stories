# Copy to .env and fill in.

# Transcription — ElevenLabs Scribe is the archive's one engine (npm run add,
# npm run retranscribe). Required for adding or re-transcribing stories.
ELEVENLABS_API_KEY=your-key-here
# ELEVENLABS_STT_MODEL=scribe_v2

# Image generation (header candidates, storyboards, the forest landscape) — the
# only Gemini call left. Story analysis and prompt writing are done by the
# Claude Code agent, not by an API.
GEMINI_API_KEY=your-key-here
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image    # newest; gemini-3-pro-image tested worse for this style
# HEADER_IMAGE_SIZE=2K                         # 1K | 2K | 4K (served webp is 1280px wide)

# Optional: a second engine for `npm run bakeoff` comparisons only.
# OPENAI_API_KEY=
# OPENAI_STT_MODEL=gpt-4o-transcribe-diarize

# FAKE_GEMINI=1 stubs the paid calls (canned transcript, solid-color images)
# so the studio / add flow can be exercised without API spend.
